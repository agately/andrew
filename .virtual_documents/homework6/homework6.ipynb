# 5 Let’s Play Checkers!


def zeroArray():
    return np.zeros((8, 8))


zeroArray()


def oddRowPattern():
    arr = np.zeros((8, 8), dtype=int)
    
    pattern = np.array([1, 0] * 4) 
    
    arr[1] = pattern
    arr[3] = pattern
    arr[5] = pattern
    arr[7] = pattern
    
    return arr


oddRowPattern()


def checkerboard():
    board = np.zeros((8, 8), dtype=int)
    pattern1 = np.array([1, 0] * 4)
    pattern2 = np.array([0, 1] * 4)
    
    board[0] = pattern1
    board[1] = pattern2
    board[2] = pattern1
    board[3] = pattern2
    board[4] = pattern1
    board[5] = pattern2
    board[6] = pattern1
    board[7] = pattern2
    
    return board


checkerboard()


def reverse_checkerboard():
    board = np.zeros((8, 8), dtype=int)
    pattern1 = np.array([0, 1] * 4)
    pattern2 = np.array([1, 0] * 4)

    board[0] = pattern1
    board[1] = pattern2
    board[2] = pattern1
    board[3] = pattern2
    board[4] = pattern1
    board[5] = pattern2
    board[6] = pattern1
    board[7] = pattern2

    return board


reverse_checkerboard()


#6 The Expanding Universe


def expansion(arr, n):
    result = []
    spaces = " " * n     
    
    for word in arr:
        new_word = ""    
        for i in range(len(word)):
            new_word = new_word + word[i]  
            if i != len(word) - 1:
                new_word = new_word + spaces   
        result.append(new_word)
    return np.array(result)


expansion("word", 1)


def secondDimmest(arr):
    result = []
    
    for row in arr:   
        sorted_row = np.sort(row)
        second_brightest = sorted_row[-2]
        result.append(second_brightest)
    return np.array(result)






